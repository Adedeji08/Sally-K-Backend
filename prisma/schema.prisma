generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerCategory {
  DRESSES
  TOPS
  MEN
  SHOES
  BAGS
  ACCESSORIES
  MIXED
}

enum IdType {
  NIN
  BVN
  PASSPORT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model User {
  id                          String    @id @default(uuid())
  fullName                    String
  email                       String    @unique
  phoneNumber                 String    @unique
  password                    String
  role                        Role
  resetPasswordToken          String?
  resetPasswordExpiresAt      DateTime?
  emailVerified               Boolean   @default(false)
  emailVerificationCode       String?
  emailVerificationExpiresAt  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  sellerProfile SellerProfile?
  reviews       Review[]
  cartItems     CartItem[]
  orders        Order[]

  @@map("users")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName    String
  categories   SellerCategory[]
  bio          String
  logoUrl      String?
  instagramUrl String?
  facebookUrl  String?
  // Where the seller operates from — shown to buyers at checkout so they can
  // arrange delivery directly with the seller.
  address      String?

  verificationStatus         VerificationStatus @default(UNVERIFIED)
  idType                     IdType?
  idNumber                   String?
  idDocumentUrl              String?
  businessType               String?
  businessRegistrationNumber String?
  businessDocumentUrl        String?

  products Product[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller_profiles")
}

model Product {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String
  price       Float
  category    SellerCategory
  images      String[]
  sizes       String[]
  colors      String[]
  stock       Int      @default(0)
  isActive    Boolean  @default(true)

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size     String @default("")
  color    String @default("")
  quantity Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size, color])
  @@map("cart_items")
}

// One order per seller per checkout — a cart spanning multiple sellers splits
// into one Order each, so each seller's dashboard only ever sees their own.
model Order {
  id       String        @id @default(uuid())
  buyerId  String
  buyer    User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  status   OrderStatus @default(PENDING)
  subtotal Float

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// Line items snapshot the product's name/image/price at order time so order
// history stays accurate even if the product is later edited or deleted.
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name     String
  image    String?
  price    Float
  size     String
  color    String
  quantity Int

  @@map("order_items")
}
