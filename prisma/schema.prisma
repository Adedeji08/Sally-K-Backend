generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerCategory {
  DRESSES
  TOPS
  MEN
  SHOES
  BAGS
  ACCESSORIES
  MIXED
}

enum IdType {
  NIN
  BVN
  PASSPORT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

// Orders only ever move PENDING -> FULFILLED or PENDING -> CANCELLED (see
// order.service#updateOrderStatus), so an EARN entry is only ever created at
// the fulfillment transition — there is no later cancellation to reverse it.
// If that state machine changes (refunds, post-fulfillment cancellation),
// this will need a REVERSED status too.
enum LoyaltyTransactionStatus {
  PENDING
  ACTIVE
}

model User {
  id                          String    @id @default(uuid())
  fullName                    String
  email                       String    @unique
  phoneNumber                 String    @unique
  password                    String
  role                        Role
  resetPasswordToken          String?
  resetPasswordExpiresAt      DateTime?
  emailVerified               Boolean   @default(false)
  emailVerificationCode       String?
  emailVerificationExpiresAt  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  sellerProfile SellerProfile?
  reviews       Review[]
  cartItems     CartItem[]
  orders        Order[]
  payments      Payment[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("users")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName    String
  categories   SellerCategory[]
  bio          String
  logoUrl      String?
  instagramUrl String?
  facebookUrl  String?
  // Where the seller operates from — shown to buyers at checkout so they can
  // arrange delivery directly with the seller.
  address      String?

  verificationStatus         VerificationStatus @default(UNVERIFIED)
  idType                     IdType?
  idNumber                   String?
  idDocumentUrl              String?
  businessType               String?
  businessRegistrationNumber String?
  businessDocumentUrl        String?

  products Product[]
  orders   Order[]
  clients      MeasurementClient[]
  measurements Measurement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller_profiles")
}

model Product {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String
  price       Float
  category    SellerCategory
  images      String[]
  sizes       String[]
  colors      String[]
  stock       Int      @default(0)
  isActive    Boolean  @default(true)

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size     String @default("")
  color    String @default("")
  quantity Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size, color])
  @@map("cart_items")
}

// One order per seller per checkout — a cart spanning multiple sellers splits
// into one Order each, so each seller's dashboard only ever sees their own.
// All orders from the same checkout share one Payment (one Paystack charge).
model Order {
  id       String        @id @default(uuid())
  buyerId  String
  buyer    User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  status   OrderStatus @default(PENDING)
  subtotal Float

  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// One Paystack transaction per checkout, covering every seller's order from
// that cart. Orders are only created once this flips to PAID — see
// order.service#createOrdersForPayment.
model Payment {
  id      String @id @default(uuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  reference        String        @unique
  amount           Float
  status           PaymentStatus @default(PENDING)
  accessCode       String?
  authorizationUrl String?
  paidAt           DateTime?

  // Loyalty points applied as a discount on this checkout (amount above is
  // already net of pointsDiscount — it's what Paystack actually charged).
  // Snapshotted here rather than recomputed at verify-time so a mid-flight
  // change to the redemption rate can't create a mismatch.
  pointsRedeemed Int   @default(0)
  pointsDiscount Float @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// Line items snapshot the product's name/image/price at order time so order
// history stays accurate even if the product is later edited or deleted.
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name     String
  image    String?
  price    Float
  size     String
  color    String
  quantity Int

  @@map("order_items")
}

// Append-only ledger — balances are always computed by summing this table,
// never stored denormalized, so there's nothing to drift out of sync.
model LoyaltyTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set for EARN rows (the order that earned them); null for REDEEM rows,
  // which pay for a *future* order via Payment.pointsRedeemed instead.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type   LoyaltyTransactionType
  status LoyaltyTransactionStatus @default(ACTIVE)
  // Signed: positive for EARN, negative for REDEEM. Only ACTIVE rows count
  // toward a user's spendable balance.
  points Int

  description String
  // EARN rows only: when a PENDING row should flip to ACTIVE.
  availableAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_transactions")
}

enum Gender {
  MALE
  FEMALE
}

enum MeasurementUnit {
  INCH
  CM
}

enum FitPreference {
  SLIM
  REGULAR
  LOOSE
}

// A designer's own client book — people they take measurements for. Not
// linked to buyer accounts: most tailoring clients never sign up.
model MeasurementClient {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name   String
  phone  String?
  gender Gender
  notes  String?

  measurements Measurement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@map("measurement_clients")
}

// One measuring session for one outfit. `values` maps template field keys
// (see measurement.templates.ts) to numbers in `unit` — stored as JSON so new
// garments/fields don't need a migration.
model Measurement {
  id       String            @id @default(uuid())
  sellerId String
  seller   SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  clientId String
  client   MeasurementClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  garmentType String
  unit        MeasurementUnit @default(INCH)
  fit         FitPreference   @default(REGULAR)
  values      Json
  occasion    String?
  dueDate     DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([clientId])
  @@map("measurements")
}
